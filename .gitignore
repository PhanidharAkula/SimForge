# -----------------------------
# Python
# -----------------------------
__pycache__/
*.pyc
*.pyo
*.pyd
*.pkl

# Virtual environment
.venv/
env/
venv/

# IDEs


# Build / packaging
build/
dist/
*.egg-info/

# VS Code
.vscode/
.history/

# macOS system files
.DS_Store
.AppleDouble
.LSOverride

# iCloud Drive conflict copies
*.icloud
* (Autosaved).*
* (conflicted copy)*

# Test cache
.pytest_cache/
.coverage
htmlcov/

# Logs
*.log

# Output directories from SUMO pipeline
out/
output/
results/

# Possible SUMO generated files
*.sumocfg
*.net.xml
*.rou.xml
*.tripinfo.xml
*.fcd.xml

# Tmp
tmp/
temp/

# ModelGen raw data (large census model files)
*_model.txt

# ModelGen scanner cache (regenerated automatically; per-machine fingerprints)
.modelgen_cache.json

# OSM Overpass API cache (regenerated on demand)
cache/

# OSM PBF snapshots — large binary data, tracked via osm_data/manifest.json
# (download with: python tools/download_osm.py)
osm_data/*.osm.pbf

# External libraries / downloaded JARs (see SETUP.md for install)
lib/

# Benchmark output runs (generated data)
runs/

# Generated scenario bundles — only the reference chicago_1k_car is tracked.
# Other dirs (nyc_500k_car, la_*_car, custom user bundles, …) are user-generated
# output (often >100 MB each) and shouldn't bloat the repo.
scenarios/*/

# Per-user cluster scratch at the repo root (anchored with leading slash so
# the patterns don't shadow the tracked cluster/jobs/ and cluster/example_runs/).
#   /jobs/  user-tweaked copies of sbatch templates (filenames stable, contents per-user)
#   /logs/  SLURM stdout/stderr (filenames embed JobIDs that change every run)
/jobs/
/logs/
cluster/logs/*.out
cluster/logs/*.err
