__pycache__/
*.pyc
*.pyo
*.pyd
*.pkl

# Virtual environment
.venv/
env/
venv/

# Build / packaging
build/
dist/
*.egg-info/

# VS Code
.vscode/
.history/

# macOS system files
.DS_Store
.AppleDouble
.LSOverride

# iCloud Drive conflict copies
*.icloud
* (Autosaved).*
* (conflicted copy)*

# Test cache
.pytest_cache/
.coverage
htmlcov/

# Logs
*.log

# Output directories from SUMO pipeline
out/
output/
results/

# Possible SUMO generated files
*.sumocfg
*.net.xml
*.rou.xml
*.tripinfo.xml
*.fcd.xml

# Tmp
tmp/
temp/

# ModelGen raw data (large census model files)
*_model.txt

# ModelGen scanner cache (regenerated automatically; per-machine fingerprints)
.modelgen_cache.json

# OSM Overpass API cache (regenerated on demand)
cache/

# OSM PBF snapshots, large binary data, tracked via osm_data/manifest.json
# (download with: python tools/download_osm.py)
osm_data/*.osm.pbf

# External libraries / downloaded JARs (see SETUP.md for install).
# Use `lib/*` (not `lib/`) so we can re-include per-engine manifest.json
# files, git doesn't allow re-including paths under a fully-excluded parent.
lib/*
# DTALite version pin needs to be tracked, same role osm_data/manifest.json
# plays for PBFs. (LPSim manifest was deleted in Version_5; see
# doc/engines/LPSIM_RETROSPECTIVE.md.)
!lib/dtalite/
lib/dtalite/*
!lib/dtalite/manifest.json
# Wave 2 (containerization): the container manifest tracks the pinned
# GHCR digest used by thesis-tier runs. Same pattern as lib/dtalite/.
!lib/container/
lib/container/*
!lib/container/manifest.json

# Benchmark output runs (generated data)
runs/

# Generated scenario bundles. Three reference bundles are tracked so a fresh
# clone can run tests and the bundled adapters without first generating data:
#   - chicago_1k_car  (~1 MB), smallest, used as the test fixture
#   - nyc_10k_car     (~36 MB), small commute tier
#   - la_50k_car      (~140 MB), medium tier; cross-platform reproducibility ref
# Two larger tiers are NOT tracked, their network.xml / signals.xml files
# individually exceed GitHub's 100 MB hard limit and would bloat clones.
# Regenerate them with the corresponding scripts/ entry point:
#   - chicago_200k_car  → scripts/04_chicago_200k_car.py
#   - nyc_500k_car      → scripts/05_nyc_500k_car.py
scenarios/*/
!scenarios/chicago_1k_car/
!scenarios/nyc_10k_car/
!scenarios/la_50k_car/

# Per-user cluster scratch at the repo root (anchored with leading slash so
# the patterns don't shadow the tracked cluster/jobs/ and cluster/example_runs/).
#   /jobs/  user-tweaked copies of sbatch templates (filenames stable, contents per-user)
#   /logs/  SLURM stdout/stderr (filenames embed JobIDs that change every run)
/jobs/
/logs/
cluster/logs/*.out
cluster/logs/*.err

# -----------------------------
# Personal / scratch documents kept in the repo dir for convenience
# but not part of the shipped artefact
# (third-party copyrighted PDFs: do NOT commit;
#  doc/figures/*.pdf are SimForge-generated and tracked separately)
# -----------------------------
a personal PDF
wsc2023_cityscape.pdf
esm23.pdf
simforge_thesis.zip
Plan/
